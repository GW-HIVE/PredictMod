FROM python:3.14-slim

WORKDIR /app

# Prevent Python from writing .pyc files and enable unbuffered logging
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade -r requirements.txt

# Copy the rest of your application code
COPY . .

# Expose the port FastAPI runs on inside the container
EXPOSE 8000



# Run the Flask app using Waitress WSGI server
# Assuming your app instance is named `app` inside `app/app.py` or `app/main.py`
CMD ["waitress-serve", "--host=0.0.0.0", "--port=8001", "app.main:app"]
